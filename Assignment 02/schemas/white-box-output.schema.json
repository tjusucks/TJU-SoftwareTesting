{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assignment02/white-box-output.schema.json",
  "title": "WhiteBoxOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_metadata",
    "model_type",
    "paths",
    "coverage_metrics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.(0|1)$"
    },
    "run_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "feature_id",
        "prompt_version",
        "revision",
        "generated_at"
      ],
      "properties": {
        "run_id": { "type": "string" },
        "feature_id": { "type": "string" },
        "prompt_version": { "type": "string" },
        "revision": { "type": "integer", "minimum": 0 },
        "generated_at": { "type": "string" }
      }
    },
    "model_type": {
      "type": "string",
      "enum": ["state", "path"]
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "guard": { "type": "string" },
          "action": { "type": "string" },
          "requirement_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" },
          "notes": { "type": "string" },
          "requirement_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "condition": { "type": "string" },
          "notes": { "type": "string" },
          "requirement_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "steps", "coverage"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "steps": {
            "type": "array",
            "items": { "type": "string" }
          },
          "coverage": {
            "type": "array",
            "items": { "type": "string" }
          },
          "requirement_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "test_intent": { "type": "string" },
          "expected_internal_effect": { "type": "string" }
        }
      }
    },
    "coverage_metrics": {
      "type": "object",
      "required": ["state_coverage_pct", "transition_coverage_pct"],
      "additionalProperties": false,
      "properties": {
        "state_coverage_pct": { "type": ["number", "null"] },
        "transition_coverage_pct": { "type": ["number", "null"] },
        "branch_coverage_pct": { "type": ["number", "null"] },
        "path_coverage_pct": { "type": ["number", "null"] },
        "raw_metrics": { "type": "object" }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "model_type": { "const": "state" } } },
      "then": { "required": ["states", "transitions"] }
    },
    {
      "if": { "properties": { "model_type": { "const": "path" } } },
      "then": { "required": ["nodes", "edges"] }
    }
  ]
}
