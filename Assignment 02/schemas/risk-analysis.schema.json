{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assignment02/risk-analysis.schema.json",
  "title": "RiskAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_id",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.0$"
    },

    "feature_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },

    "items": {
      "type": "array",
      "minItems": 1,

      "items": {
        "type": "object",
        "additionalProperties": false,

        "required": [
          "risk_id",
          "requirement_id",
          "risk_categories",
          "impact",
          "likelihood",
          "risk_score",
          "priority",
          "rationale"
        ],

        "properties": {

          "risk_id": {
            "type": "string",
            "pattern": "^RK[0-9]+$"
          },

          "requirement_id": {
            "type": "string",
            "pattern": "^R[0-9]+$"
          },

          "risk_categories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "Authentication",
                "Authorization",
                "InputValidation",
                "BusinessLogic",
                "DataIntegrity",
                "DataPersistence",
                "APIContract",
                "ErrorHandling",
                "StateTransition",
                "ExternalDependency",
                "Performance",
                "Other"
              ]
            }
          },

          "impact": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Business impact if the requirement fails."
          },

          "likelihood": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Likelihood of failure or defect occurrence."
          },

          "risk_score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "description": "Calculated as Impact * Likelihood."
          },

          "priority": {
            "type": "string",
            "enum": [
              "High",
              "Medium",
              "Low"
            ]
          },

          "rationale": {
            "type": "string",
            "minLength": 1
          },

          "recommendations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

