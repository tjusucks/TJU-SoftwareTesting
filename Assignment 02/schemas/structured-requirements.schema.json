{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assignment02/structured-requirements.schema.json",
  "title": "StructuredRequirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_name",
    "feature_id",
    "feature_name",
    "requirement_items"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.0$"
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "feature_name": {
      "type": "string",
      "minLength": 1
    },
    "source_path": {
      "type": "string"
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "business_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirement_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "input_fields",
          "data_ranges",
          "conditions",
          "expected_actions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[0-9]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "input_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data_ranges": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
