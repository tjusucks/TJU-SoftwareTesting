{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assignment02/designer-revisions.schema.json",
  "title": "DesignerRevisions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_id",
    "revision",
    "designer_revisions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.0$"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "designer_revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "target_type",
          "reason"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "add",
              "modify",
              "remove"
            ]
          },
          "target_type": {
            "type": "string",
            "enum": [
              "coverage_item",
              "test_case",
              "decision_table_row",
              "traceability"
            ]
          },
          "target_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "payload": {
            "type": [
              "object",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
