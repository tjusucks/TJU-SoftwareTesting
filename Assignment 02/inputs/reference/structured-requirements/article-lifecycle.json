{
  "schema_version": "1.0",
  "project_name": "RealWorld",
  "feature_id": "article-lifecycle",
  "feature_name": "Article Lifecycle",
  "source_path": "Assignment 01/codebases/realworld/specification/features/article-lifecycle.md",
  "actors": [
    "authenticated owner",
    "authenticated non-owner",
    "unauthenticated user"
  ],
  "preconditions": [
    "API service is reachable",
    "At least one registered user exists",
    "Token issuance is available for authenticated operations"
  ],
  "business_rules": [
    "Creating article requires authentication",
    "Duplicate titles are allowed but generated slug must stay unique",
    "Omitting tagList in update preserves existing tags",
    "Empty tagList in update removes all tags",
    "Null tagList in update is rejected"
  ],
  "input_constraints": [
    "Create payload requires non-empty title, description, body",
    "Update payload supports partial fields",
    "Slug is required for GET/PUT/DELETE target operations"
  ],
  "error_conditions": [
    "Unauthenticated write actions are rejected",
    "Empty required fields are rejected",
    "Deleted article retrieval should fail"
  ],
  "requirement_items": [
    {
      "id": "R1",
      "description": "Creating an article requires authentication.",
      "input_fields": ["authorization", "article.title", "article.description", "article.body"],
      "data_ranges": ["authorization token present"],
      "conditions": ["POST /articles"],
      "expected_actions": ["Reject unauthenticated request"]
    },
    {
      "id": "R2",
      "description": "Creating an article with valid input succeeds with status 201.",
      "input_fields": ["article.title", "article.description", "article.body", "article.tagList"],
      "data_ranges": ["non-empty strings"],
      "conditions": ["authenticated user", "valid JSON payload"],
      "expected_actions": ["Return 201", "Return created article object"]
    },
    {
      "id": "R3",
      "description": "Created article response includes title, slug, description, body, tagList, createdAt, updatedAt, favorited, favoritesCount, author.username.",
      "input_fields": ["response.article.*"],
      "data_ranges": ["expected response fields present"],
      "conditions": ["successful create"],
      "expected_actions": ["Return complete article representation"]
    },
    {
      "id": "R4",
      "description": "Duplicate titles are allowed and each created article has a unique slug.",
      "input_fields": ["article.title", "response.article.slug"],
      "data_ranges": ["same title reused across creates"],
      "conditions": ["two successful creates by authenticated user"],
      "expected_actions": ["Both creates succeed", "Slugs are different"]
    },
    {
      "id": "R5",
      "description": "Empty title is rejected.",
      "input_fields": ["article.title"],
      "data_ranges": ["empty string"],
      "conditions": ["POST /articles"],
      "expected_actions": ["Return validation error"]
    },
    {
      "id": "R6",
      "description": "Empty description is rejected.",
      "input_fields": ["article.description"],
      "data_ranges": ["empty string"],
      "conditions": ["POST /articles"],
      "expected_actions": ["Return validation error"]
    },
    {
      "id": "R7",
      "description": "Empty body is rejected.",
      "input_fields": ["article.body"],
      "data_ranges": ["empty string"],
      "conditions": ["POST /articles"],
      "expected_actions": ["Return validation error"]
    },
    {
      "id": "R8",
      "description": "Unauthenticated create attempts are rejected.",
      "input_fields": ["authorization"],
      "data_ranges": ["missing token"],
      "conditions": ["POST /articles"],
      "expected_actions": ["Return unauthorized error"]
    },
    {
      "id": "R9",
      "description": "Updating article body succeeds for the owner.",
      "input_fields": ["authorization", "slug", "article.body"],
      "data_ranges": ["non-empty body"],
      "conditions": ["PUT /articles/{slug}", "owner token"],
      "expected_actions": ["Return success status", "Body is updated"]
    },
    {
      "id": "R10",
      "description": "After update, unchanged fields remain unchanged unless explicitly modified.",
      "input_fields": ["article.title", "article.description", "article.body", "article.tagList"],
      "data_ranges": ["partial update payload"],
      "conditions": ["successful owner update"],
      "expected_actions": ["Only supplied fields change"]
    },
    {
      "id": "R11",
      "description": "Omitting tagList during update preserves existing tags.",
      "input_fields": ["article.tagList"],
      "data_ranges": ["field omitted"],
      "conditions": ["PUT /articles/{slug}", "existing tags present"],
      "expected_actions": ["Existing tags unchanged"]
    },
    {
      "id": "R12",
      "description": "Setting tagList to an empty array removes all tags.",
      "input_fields": ["article.tagList"],
      "data_ranges": ["[]"],
      "conditions": ["PUT /articles/{slug}"],
      "expected_actions": ["Tag list becomes empty"]
    },
    {
      "id": "R13",
      "description": "Setting tagList to null is rejected.",
      "input_fields": ["article.tagList"],
      "data_ranges": ["null"],
      "conditions": ["PUT /articles/{slug}"],
      "expected_actions": ["Return validation error"]
    },
    {
      "id": "R14",
      "description": "Update persistence is observable when article is fetched again.",
      "input_fields": ["slug", "GET response"],
      "data_ranges": ["post-update fetch"],
      "conditions": ["PUT then GET same slug"],
      "expected_actions": ["GET reflects update state"]
    },
    {
      "id": "R15",
      "description": "Deleting an existing owned article succeeds.",
      "input_fields": ["authorization", "slug"],
      "data_ranges": ["existing slug"],
      "conditions": ["DELETE /articles/{slug}", "owner token"],
      "expected_actions": ["Return success status for deletion"]
    },
    {
      "id": "R16",
      "description": "After deletion, later retrieval of that article fails or indicates not found.",
      "input_fields": ["slug"],
      "data_ranges": ["deleted slug"],
      "conditions": ["DELETE then GET same slug"],
      "expected_actions": ["GET does not return active article"]
    }
  ]
}
